# Target ESP32 classic (WROOM-32 / ESP-32S module). Chip has 4 MB flash.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: use Bluedroid + BLE Mesh (the BLE Mesh stack is most mature on
# Bluedroid in IDF v5.3; NimBLE-on-mesh exists but is harder to drive).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# BLE Mesh — node, not provisioner. We self-inject keys via internal APIs
# instead of getting provisioned by Sidus.
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
CONFIG_BLE_MESH_RELAY=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_FRIEND=n
CONFIG_BLE_MESH_LOW_POWER=n

# Sizing — we have a single subnet (the studio mesh) and a single AppKey.
CONFIG_BLE_MESH_SUBNET_COUNT=1
CONFIG_BLE_MESH_APP_KEY_COUNT=2
CONFIG_BLE_MESH_MODEL_KEY_COUNT=2
CONFIG_BLE_MESH_MODEL_GROUP_COUNT=4
CONFIG_BLE_MESH_CRPL=20

# Larger main task stack since mesh init + AES-CCM uses some.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Wi-Fi: STA only, used for MQTT + HTTP API alongside BLE Mesh.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP32_WIFI_NVS_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# HTTP server (for the REST API).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# Socket pool: all HTTP sessions plus MQTT and the rest must fit, or the
# server locks every client out (main/http.c, 2026-09-21). Default 10.
CONFIG_LWIP_MAX_SOCKETS=16

# Logging.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Signed firmware updates (security audit, 2026-09-13): the running firmware only
# accepts OTA images signed with the private key in secure_boot_signing_key.pem
# (gitignored; generate it once, see README). ECDSA (V1) is the scheme the classic
# ESP32 supports without hardware secure boot. The bootloader stays as it is, so
# this can be switched on over OTA; a USB flash still accepts any image, which is
# also the way back if the key is lost.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_SIGNED_ON_BOOT_NO_SECURE_BOOT is not set
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# OTA rollback (2026-09-13): a new image boots "pending verify" and is only marked
# valid once its own HTTP server answers /status and enough memory is free
# (http.c, image_check_task; since 2026-09-14). A crash before that, or no success
# within 5 minutes, makes the device start the previous image. Lives in the
# bootloader, so switching it on needed one USB flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TLS memory (measured 2026-09-13 with a test build that ran an extra MQTT-over-TLS
# client next to the normal plain one, P-256 server certificate):
#   default buffers: 36 KB free with TLS, 18.5 KB lowest after the handshake,
#                    2.2 KB lowest during a firmware upload — close to a crash.
#   dynamic buffers: 59 KB free, 39.5 KB lowest after the handshake, 31 KB
#                    lowest during an upload. (RSA-2048 server certificate: 27 KB
#                    and 11 KB — use an EC certificate for the broker.)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
