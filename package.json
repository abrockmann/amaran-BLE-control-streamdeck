{
  "name": "amaran-light",
  "version": "0.0.1",
  "description": "Control Amaran 150c light via Bluetooth",
  "main": "dist/index.js",
  "bin": {
    "amaran": "./dist/index.js"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "daemon:start": "tsx src/daemon.ts",
    "daemon:stop": "tsx src/cli.ts stop",
    "amaran": "tsx src/cli.ts",
    "mesh:on": "tsx src/cli.ts on",
    "mesh:off": "tsx src/cli.ts off",
    "mesh:brightness": "tsx src/cli.ts brightness",
    "mesh:cct": "tsx src/cli.ts cct",
    "mesh:hsi": "tsx src/cli.ts hsi",
    "scan": "tsx src/ble-scanner.ts scan",
    "discover": "tsx src/ble-scanner.ts connect",
    "gen-config": "tsx scripts/generate-config.ts",
    "mqtt:watch": "tsx scripts/mqtt-watch.ts",
    "esp32:capture": "tsx scripts/esp32-capture.ts",
    "esp32:probe": "tsx scripts/esp32-probe.ts",
    "test:plugin": "node streamdeck/test-plugin.mjs",
    "build": "tsc"
  },
  "keywords": [
    "amaran",
    "aputure",
    "bluetooth",
    "ble",
    "light",
    "control"
  ],
  "author": "Wes Bos (https://wesbos.com/)",
  "contributors": [
    "Arne Brockmann"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrockmann/amaran-BLE-control-streamdeck.git"
  },
  "type": "module",
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26"
  },
  "optionalDependencies": {
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "@esbuild/darwin-arm64": "0.27.2",
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
